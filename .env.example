# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@ep-curly-heart-aor7ejci-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Custom Auth (JWT HS512)
JWT_SECRET=change-this-to-a-random-secret-in-production

# Cloudflare R2 / S3-compatible storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=asset-flow
R2_PUBLIC_URL=
R2_REGION=us-east-1

# Mailgun (email notifications)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAIL_NOTIFICATION_TO=

# Debug
DEBUG_MIDDLEWARE=false
PERF_DIAG=0
NEXT_PUBLIC_PERF_DIAG=0
