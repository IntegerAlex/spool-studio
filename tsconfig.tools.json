{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "ES2022",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["tools/**/*.ts"],
  "exclude": ["node_modules"]
}
